# Copia de pruebas (staging) de polmorera.es, servida en https://polmorera.es/test/
# Nunca debe indexarse. Mismo comportamiento que tendrá producción:
# cada URL sirve su HTML prerenderizado y lo que no existe devuelve 404.
:80 {
	root * /srv
	encode zstd gzip
	header X-Robots-Tag "noindex, nofollow"

	redir /test /test/ 308

	# Archivos con nombre único por versión: caché larga
	@assets path /test/assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Páginas sin barra final -> con barra (/test/casos -> /test/casos/)
	@noslash {
		not path */
		file {path}/index.html
	}
	redir @noslash {path}/ 308

	try_files {path} {path}/index.html
	file_server

	handle_errors {
		@notfound expression {err.status_code} == 404
		handle @notfound {
			rewrite * /test/404.html
			file_server {
				status 404
			}
		}
	}
}
